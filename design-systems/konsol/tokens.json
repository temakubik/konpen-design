{
  "meta": {
    "name": "Консоль",
    "description": "Modern professional platform for self-employed and enterprise clients"
  },
  "colors": {
    "primary": "#7B36FF",
    "primaryDark": "#6223DB",
    "primaryLight": "#E7DBFF",
    "primarySubtle": "#D5BBFD",
    "secondary": "#BBEE54",
    "secondaryDark": "#A8D840",
    "success": "#008945",
    "successBg": "#E8F5E9",
    "error": "#E52A05",
    "textPrimary": "#181818",
    "textSecondary": "#495057",
    "textTertiary": "#727272",
    "black": "#000000",
    "white": "#FFFFFF",
    "background": "#FFFFFF",
    "backgroundAlt": "#F2F0F6",
    "backgroundSubtle": "#F0E7FE",
    "backgroundLight": "#F3F3F3",
    "border": "#DEE2E6"
  },
  "typography": {
    "fontFamily": "Graphik, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif",
    "fontFamilyMono": "Cofosansmono, Monaco, 'Courier New', monospace",
    "scale": [
      { "role": "Display / H1", "size": 56, "weight": 700, "lineHeight": 56 },
      { "role": "Heading H2",  "size": 48, "weight": 700, "lineHeight": 48 },
      { "role": "Heading H3",  "size": 32, "weight": 700, "lineHeight": 32 },
      { "role": "Body",        "size": 20, "weight": 400, "lineHeight": 28 },
      { "role": "UI Label",    "size": 16, "weight": 700, "lineHeight": 19 },
      { "role": "Link / Body Compact", "size": 16, "weight": 400, "lineHeight": 22 },
      { "role": "Button / Mono", "size": 14, "weight": 400, "lineHeight": 17, "mono": true }
    ]
  },
  "spacing": [4, 8, 12, 16, 20, 24, 32, 40, 48, 60, 64, 80],
  "radii": {
    "none": 0,
    "input": 8,
    "dropdown": 12,
    "card": 16,
    "button": 40,
    "pill": 800
  },
  "shadows": {
    "none": "none",
    "raised": "rgba(16,24,40,0.04) 0px 4px 6px -2px, rgba(16,24,40,0.08) 0px 12px 16px -4px",
    "floating": "rgba(16,24,40,0.08) 0px 20px 25px -5px, rgba(16,24,40,0.1) 0px 25px 50px -12px"
  }
}
